# ════════════════════════════════════════════════════════════
#  متغيرات البيئة لمشروع مسجد طه
#  ─────────────────────────────────────────────────────────
#  للتطوير المحلي: انسخ هذا الملف إلى .env واملأ القيم
#  على Render: أضف كل متغير في:
#    Dashboard → Service → Environment → Add Environment Variable
# ════════════════════════════════════════════════════════════

# ── أساسي (مطلوب) ────────────────────────────────────────
# مفتاح سري طويل وعشوائي — ولّده بـ:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-very-long-random-secret-key-here

# ── البيئة ───────────────────────────────────────────────
# True للتطوير المحلي فقط — اتركها False في الإنتاج
DEBUG=False

# المضيفون المسموح بهم (فصل بفواصل بدون مسافات)
ALLOWED_HOSTS=your-app.onrender.com,www.your-domain.com

# أصول CSRF الموثوقة (مطلوبة لـ HTTPS)
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://www.your-domain.com

# ── قاعدة البيانات (Supabase عبر الـ Session Pooler المتوافق مع IPv4) ──
# الرابط بدون كلمة المرور وبدون علامات تنصيص ولا ?pgbouncer=true
DATABASE_URL=postgresql://postgres.<project-ref>@aws-0-<region>.pooler.supabase.com:5432/postgres
# كلمة مرور قاعدة البيانات كما هي (بدون أقواس [ ])
DB_PASSWORD=your-database-password

# ── تلغرام ───────────────────────────────────────────────
# احصل على التوكن من @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# للحصول على CHAT_ID: أرسل رسالة للبوت ثم افتح:
# https://api.telegram.org/bot<TOKEN>/getUpdates
# وابحث عن "chat":{"id": ...}
TELEGRAM_CHAT_ID=-1001234567890

# ── واتساب WAHA (اختياري) ────────────────────────────────
WAHA_RENDER_URL=https://your-waha-instance.onrender.com
WAHA_API_KEY=your-waha-api-key

# ── المساعد الإحصائي بالذكاء الاصطناعي: Google Gemini (اختياري) ─────────────
# مطلوب **متغيّر واحد فقط**: مفتاح Gemini من https://aistudio.google.com/apikey
# بدونه تعمل الصفحة بوضع «تعديل التفسير» اليدوي فقط.
GEMINI_API_KEY=AIza...
# (العنوان والنموذج لهما قيم افتراضية جاهزة: generativelanguage.googleapis.com/v1beta + gemini-flash-latest)
# اختياري فقط إن أردت تغييرهما أو استخدام مزوّد آخر:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_MODEL=gemini-flash-latest
# أقصى عدد أسئلة للذكاء الاصطناعي في الساعة لكل مستخدم
ASSISTANT_RATE_LIMIT_PER_HOUR=30

# ── الترحيلات التلقائية (اختياري) ────────────────────────────
# التطبيق يطبّق الترحيلات المعلّقة عند الإقلاع تلقائياً. عطّلها إن أردت الاعتماد
# على build.sh فقط: AUTO_MIGRATE=false
# AUTO_MIGRATE=true
# أمر `manage.py migrate` يتجاوز تلقائياً الجداول الموجودة فعلاً (already exists).
# لتعطيل هذا السلوك وجعله أمر Django الأصلي: SMART_MIGRATE=false

# ── أمان الجلسة (اختياري) ─────────────────────────────────────
# مدة بقاء تسجيل الدخول بالساعات (الافتراضي 336 = أسبوعان)
# SESSION_AGE_HOURS=12
# إنهاء الجلسة عند إغلاق المتصفح
# SESSION_EXPIRE_AT_BROWSER_CLOSE=true
